# ---- Lumina API configuration ----
NODE_ENV=development

# Where the React app is served. Users are redirected here after sign-in.
APP_ORIGIN=http://localhost:5173
# Extra origins allowed to call the API with credentials (comma-separated). APP_ORIGIN is always allowed.
ALLOWED_ORIGINS=

# At least 32 random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# SQLite/libSQL connection. Use a libsql:// URL (+ DATABASE_AUTH_TOKEN) for Turso in production.
DATABASE_URL=file:./data/lumina.db
DATABASE_AUTH_TOKEN=

# Google OAuth 2.0 "Web application" client — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the Google client.
# In dev the Vite server proxies /api to this app, so the callback goes through the web origin.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
# Optional: restrict sign-up to these email domains, e.g. "gmail.com,googlemail.com". Empty = any verified Google account.
ALLOWED_EMAIL_DOMAINS=

# Set to 1 only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0

# Local-only passwordless login for testing without Google credentials. Refused when NODE_ENV=production.
DEV_LOGIN_ENABLED=0
